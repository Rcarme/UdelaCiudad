<?xml version="1.0" encoding="utf-8"?>
<!-- SECURITY: Data extraction rules for Android 12+ (cloud backup + device transfer).
     Even though allowBackup=false, Android 12+ uses data_extraction_rules.
     Exclude same sensitive files as backup_rules.xml to prevent token leakage.
     See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Never backup token prefs -->
        <exclude domain="sharedpref" path="tgmon_prefs.xml" />
        <exclude domain="sharedpref" path="service_urls.xml" />
        <exclude domain="sharedpref" path="service_urls_encrypted.xml" />
        <!-- Exclude databases by default; restore would stale -->
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tgmon_prefs.xml" />
        <exclude domain="sharedpref" path="service_urls.xml" />
        <exclude domain="sharedpref" path="service_urls_encrypted.xml" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
