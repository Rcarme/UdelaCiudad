<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- SECURITY hardening:
         - allowBackup false: prevents TGMON_TOKEN (EncryptedSharedPreferences) leaking via adb backup / cloud.
           Still provides backup_rules / data_extraction_rules as defense-in-depth for Android 12+ if backup ever re-enabled.
         - usesCleartextTraffic false by default; cleartext only allowed via network_security_config domain-config
           for trusted local networks (Tailscale 100.64.0.0/10 + 192.168.0.0/16). WireGuard (Tailscale) encrypts
           transport, but ideally use https with valid cert; http allowed here only because target is private LAN.
    -->
    <application
        android:name=".TgMonApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TgMon"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">
        <activity
            android:name="com.tgmon.app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TgMon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.tgmon.app.widget.TgMonWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tgmon_widget_info" />
        </receiver>

    </application>

</manifest>