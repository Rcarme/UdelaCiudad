# API Authentication Tokens (generate with: openssl rand -hex 32)
# Admin token: full control (start, stop, restart, pause, token management)
TGMON_ADMIN_TOKEN=cambiar_por_un_token_largo_y_aleatorio
# Viewer token: read-only (metrics, charts, container status, logs)
TGMON_VIEWER_TOKEN=cambiar_por_un_token_largo_y_aleatorio
# Legacy fallback (if defined alone, acts as admin)
TGMON_TOKEN=cambiar_por_un_token_largo_y_aleatorio

# Optional: Gemini Flash API Key for on-demand AI analysis (falls back to local heuristics if empty)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: IP en la que publica el puerto 8000 (por defecto 0.0.0.0 = todas las interfaces).
# Recomendado: la IP de LAN o de Tailscale del server, para no exponerlo a internet.
# TGMON_BIND_ADDR=100.x.y.z

# Optional: Path to docker-compose.yml for container discovery
# COMPOSE_DEFAULT_PATH=docker-compose.yml

# Optional: Hostname override for display
# HOSTNAME_OVERRIDE=Server-01
